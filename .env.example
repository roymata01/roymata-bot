# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Meta — WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Meta — Instagram Messaging API
IG_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
# App ID/Secret propios de Instagram (flujo "Instagram API with Instagram Login"),
# distintos del App Secret general — firman los webhooks de Instagram.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Meta — Messenger Platform
FB_PAGE_ACCESS_TOKEN=
FB_PAGE_ID=

# Meta — compartido por los 3 canales (App Secret firma todos los webhooks)
META_APP_SECRET=

# --- Modo evento HYROX ---------------------------------------------------
# Se prende SOLO los días del evento. Con esto en "true", el bot detecta a los
# familiares de pacientes atendidos (que reciben alertas de la app VITA RESCUE
# desde este mismo número) y les contesta como servicio médico, no como Roy.
MODO_EVENTO_HYROX=false
# Modo paranoico: cualquier mensaje que no sea claramente de negocio se trata
# como familiar. Úsalo solo si se cuelan familiares durante el evento.
MODO_EVENTO_HYROX_ESTRICTO=false
# Supabase del proyecto HYROX (VITA RESCUE médico) — de ahí se lee la tabla
# notificaciones_whatsapp para saber a quién le mandamos una alerta.
# OJO: NO es el mismo proyecto que VITA_SUPABASE_URL (ese es el de los cursos).
HYROX_SUPABASE_URL=
HYROX_SUPABASE_KEY=
